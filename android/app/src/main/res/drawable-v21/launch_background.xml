<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: SafarPlus navy with the white logo, matching the
     Flutter splash so there is no white flash on start-up. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
